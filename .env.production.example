APP_NAME=MeuPortfolio
APP_ENV=production
APP_KEY=
APP_DEBUG=false
PORT=8080
# Initially omit APP_URL in Vercel to use its automatic VERCEL_URL host.
# Set the canonical URL below only after the custom domain is connected.
APP_URL=https://meuportfolio.ink
APP_FORCE_HTTPS=true
APP_TRUSTED_HOSTS=meuportfolio.ink,www.meuportfolio.ink
TRUSTED_PROXIES=*
DEPLOYMENT_STRICT=true

# Use a restricted app_runtime role. Migration credentials must remain separate.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/app/resources/certificates/supabase-ca.crt
DB_EMULATE_PREPARES=true

SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_COOKIE=__Host-meuportfolio_session
SESSION_LIFETIME=120
CACHE_DRIVER=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# Create one public media bucket and a separate PRIVATE attachments bucket.
PUBLIC_STORAGE_DRIVER=s3
PRIVATE_STORAGE_DRIVER=s3
STORAGE_S3_KEY=
STORAGE_S3_SECRET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=
PUBLIC_STORAGE_BUCKET=portfolio-publico
PRIVATE_STORAGE_BUCKET=orcamentos-privados
PUBLIC_STORAGE_URL=
UPLOAD_REQUEST_MAX_BYTES=3145728
PDF_RESPONSE_MAX_BYTES=4194304

MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=notificacoes@meuportfolio.ink
MAIL_FROM_NAME=MeuPortfolio

SENTRY_LARAVEL_DSN=
SENTRY_RELEASE=
GOOGLE_LOGIN_ENABLED=false
LEGAL_RESPONSAVEL=
LEGAL_CONTATO_EMAIL=
